<mxfile host="Electron" agent="ChatGPT">
  <diagram id="project3" name="Project 3 - Merchant REST API">
    <mxGraphModel dx="2910" dy="1585" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
