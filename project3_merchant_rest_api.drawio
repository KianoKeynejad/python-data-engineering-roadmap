        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" value="TYPICAL GET /merchants FLOW&#xa;&#xa;1. Client sends GET /merchants&#xa;2. FastAPI receives request&#xa;3. Depends(get_db) provides a Session&#xa;4. Route calls get_merchants(db)&#xa;5. Service builds select(Merchant)&#xa;6. db.execute(query) runs it&#xa;7. PostgreSQL returns rows&#xa;8. SQLAlchemy creates Merchant objects&#xa;9. Pydantic validates/serializes response&#xa;10. FastAPI sends JSON to client" vertex="1">
          <mxGeometry height="210" width="900" x="60" y="40" as="geometry" />
        </mxCell>
        <mxCell id="endpoints" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" value="PROJECT 3 ENDPOINTS&#xa;&#xa;GET /merchants&#xa;GET /merchants/{merchant_id}&#xa;GET /transactions&#xa;GET /transactions/{transaction_id}&#xa;GET /merchants/{merchant_id}/transactions&#xa;POST /transactions" vertex="1">
          <mxGeometry height="210" width="700" x="1000" y="40" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;CLIENT&lt;br&gt;&lt;br&gt;Browser / Postman / App&lt;br&gt;&lt;br&gt;Sends HTTP request&lt;br&gt;Receives JSON response&lt;/font&gt;" vertex="1">
